font.family: serif
font.serif: Times New Roman, STIXGeneral, DejaVu Serif
mathtext.fontset: stix
font.size: 9
axes.labelsize: 9
axes.titlesize: 9
xtick.labelsize: 9
ytick.labelsize: 9
legend.fontsize: 9
axes.linewidth: 0.6
lines.linewidth: 1.0
lines.markersize: 4
axes.spines.top: False
axes.spines.right: False
axes.grid: False
xtick.direction: out
ytick.direction: out
xtick.major.width: 0.6
ytick.major.width: 0.6
figure.facecolor: white
axes.facecolor: white
savefig.facecolor: white
pdf.fonttype: 42
ps.fonttype: 42
svg.fonttype: none
axes.unicode_minus: True
path.simplify: False
